# Docker の `tools` サービス（make migrate / db-reset / seed / generate / test-* など）の `.env`（apps/admin/.env にマウントされる）。
# アプリ用ロール（app_user）は DDL できないため、管理用ロール（app_admin。RLS をバイパス）の接続にする。
# 開発サーバー（admin / liff）には使わない（deploy/docker/app.env は app_user）。ローカル開発専用の固定値で、秘密情報ではない。
DATABASE_URL=postgresql://app_admin:app_admin@postgres:5432/club
DATABASE_URL_ADMIN=postgresql://app_admin:app_admin@postgres:5432/club
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://app_admin:app_admin@postgres:5432/club
