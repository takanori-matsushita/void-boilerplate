# Docker（docker-compose.dev.yml）で動かすアプリの `.env`（各アプリの .env にマウントされる）。
# ホストの `.env`（localhost:54329 向け）とは別。ここは、コンテナ内から見た Postgres のホスト名（postgres）を使う。
# ローカル開発専用の固定の認証情報（deploy/sql/init-roles.sql と同じ）。秘密情報ではない。
DATABASE_URL=postgresql://app_user:app_user@postgres:5432/club
DATABASE_URL_ADMIN=postgresql://app_admin:app_admin@postgres:5432/club
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://app_user:app_user@postgres:5432/club
