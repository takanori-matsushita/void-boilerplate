# ローカル開発用。コピーして .env にする（git に含めない）。docker compose の Postgres を使う例
DATABASE_URL=postgresql://app_user:app_user@localhost:54329/club
DATABASE_URL_ADMIN=postgresql://app_admin:app_admin@localhost:54329/club
# Void がローカルで Hyperdrive バインディングを使うとき（初回デプロイ後に lock へ記録される）に必要
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://app_user:app_user@localhost:54329/club
